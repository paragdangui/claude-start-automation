<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.codex.timer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/parag/bin/start-codex-timer.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Monday -->
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>__RUN_HOUR__</integer>
            <key>Minute</key>
            <integer>__RUN_MINUTE__</integer>
        </dict>
        <!-- Tuesday -->
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>__RUN_HOUR__</integer>
            <key>Minute</key>
            <integer>__RUN_MINUTE__</integer>
        </dict>
        <!-- Wednesday -->
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>__RUN_HOUR__</integer>
            <key>Minute</key>
            <integer>__RUN_MINUTE__</integer>
        </dict>
        <!-- Thursday -->
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>__RUN_HOUR__</integer>
            <key>Minute</key>
            <integer>__RUN_MINUTE__</integer>
        </dict>
        <!-- Friday -->
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>__RUN_HOUR__</integer>
            <key>Minute</key>
            <integer>__RUN_MINUTE__</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/parag/bin/logs/codex-launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/parag/bin/logs/codex-launchd-stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/parag/bin</string>
</dict>
</plist>
